FROM docker.io/library/rust@sha256:3914072ca0c3b8aad871db9169a651ccfce30cf58303e5d6f2db16d1d8a7e58f AS build
WORKDIR /source
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY src ./src
RUN rustup component add rustfmt clippy \
    && cargo fmt --all --check \
    && cargo test --locked \
    && cargo clippy --locked --all-targets -- -D warnings \
    && SHIM_BUILD_ID="$(sha256sum Cargo.toml Cargo.lock src/*.rs | sha256sum | cut -d ' ' -f1)" cargo build --locked --release

FROM docker.io/library/debian@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587
RUN groupadd --gid 1000 shim && useradd --uid 1000 --gid 1000 shim \
    && mkdir -p /data && chown 1000:1000 /data
COPY --from=build /source/target/release/vertex-shim /usr/local/bin/vertex-shim
USER 1000:1000
EXPOSE 8080 8081
ENTRYPOINT ["/usr/local/bin/vertex-shim"]
